# Copia este fichero a .env y rellena solo lo que vayas a usar.
# Los valores vacios no se consideran configurados.
# La configuracion de modelos (favorito, temperatura, tokens)
# vive en config/modelos.json y se edita desde la CLI o el Desktop.

# Nombre que se muestra en el CV (opcional; si esta vacio se usa el de UserInfo.md)
NOMBRE_USUARIO=
# Nombre base de los ficheros generados, sin espacios (opcional)
NOMBRE_ARCHIVO=

# Ollama (modelos locales)
OLLAMA_BASE_URL=http://localhost:11434

# OpenCode Zen (capa gratuita, endpoint chat/completions)
# Consigue la clave en https://opencode.ai/auth
OPENCODE_ZEN_API_KEY=

# OpenCode Go (suscripción de pago, endpoint OpenAI-compatible)
# Consigue la clave en https://opencode.ai/console/go
OPENCODE_GO_API_KEY=

# Google Gemini
# Consigue la clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude (Anthropic)
# Consigue la clave en https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Groq (compatible OpenAI)
# Consigue la clave en https://console.groq.com/keys
GROQ_API_KEY=

# Ruta al ejecutable de Chrome/Chromium (necesaria para generar PDF)
CHROME_ROUTE=
