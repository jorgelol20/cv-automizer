{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "letter",
    "emailSubject",
    "emailBody",
    "keyPoints"
  ],
  "properties": {
    "letter": {
      "type": "string",
      "minLength": 1,
      "description": "Carta de presentación completa en formato Markdown"
    },
    "emailSubject": {
      "type": "string",
      "minLength": 1,
      "description": "Asunto sugerido para el email de candidatura"
    },
    "emailBody": {
      "type": "string",
      "minLength": 1,
      "description": "Cuerpo del email (resumen de 1 párrafo)"
    },
    "keyPoints": {
      "type": "array",
      "minItems": 1,
      "description": "Puntos clave de venta del candidato",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
